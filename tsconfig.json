{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun-types"],
    "lib": ["ES2022"]
  },
  "include": [
    "index.ts",
    "kernel/**/*",
    "cli/**/*",
    "mcp/**/*",
    "control-plane/**/*",
    "examples/**/*",
    "tests/**/*",
    "web/**/*"
  ]
}
